# Talqeeh — contoh environment variable.
# Salin jadi .env lalu isi nilainya. .env sudah di-.gitignore — JANGAN commit kunci asli.
# Lokal: server API (node server.cjs) memuat .env lewat --env-file-if-exists (lihat .claude/launch.json / npm start).
# Produksi (Vercel): isi variabel yang sama di Project Settings → Environment Variables.

# ── WAJIB untuk menjalankan app & Live Caption ─────────────────────────────

# Supabase (Project Settings → API)
SUPABASE_URL=https://xxxxxxxx.supabase.co
# Kunci publik (anon), dikirim ke browser lewat /api/config
SUPABASE_ANON_KEY=
# Kunci rahasia server (service_role) — hanya dipakai di folder api/, jangan pernah ke browser
SUPABASE_SERVICE_ROLE_KEY=

# OpenRouter (openrouter.ai/keys) — semua fitur AI, termasuk transkrip & Live Caption
OPENROUTER_API_KEY=

# ── Opsional: AI ───────────────────────────────────────────────────────────

# Model utama (bawaan: anthropic/claude-sonnet-5). Model per tugas juga bisa diatur di Admin → Settings.
AI_PARTNER_MODEL=
# Model transkrip audio, harus model yang bisa mendengar audio (bawaan: google/gemini-2.5-flash)
AI_TRANSCRIBE_MODEL=
# Rahasia untuk token kredit menit Live Caption (bawaan: memakai SUPABASE_SERVICE_ROLE_KEY)
LIVE_CAPTION_SECRET=
# Batas total pemanggilan AI semua akun coba gratis per hari (bawaan: 200)
TRIAL_DAILY_LIMIT=

# ── Opsional: frontend (Vite) ──────────────────────────────────────────────

# Dipakai halaman landing; isi sama dengan SUPABASE_URL / SUPABASE_ANON_KEY
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Opsional: admin ────────────────────────────────────────────────────────

# PIN login halaman /admin
ADMIN_PIN=
# Rahasia link seminar (bawaan: ADMIN_PIN)
SEMINAR_SECRET=

# ── Opsional: URL situs ────────────────────────────────────────────────────

# Origin tetap untuk redirect login (kosong = dari header request), mis. http://localhost:5174
APP_URL=
# Dipakai di link email (bawaan: https://talqeeh.id)
SITE_URL=

# ── Opsional: WhatsApp (Fonnte) ────────────────────────────────────────────

FONNTE_TOKEN=

# ── Opsional: pembayaran (Mayar) ───────────────────────────────────────────

MAYAR_API_KEY=
# true = pakai sandbox Mayar
MAYAR_SANDBOX=true
# Token verifikasi webhook Mayar
MAYAR_WEBHOOK_TOKEN=
# Teruskan webhook ke URL lain (opsional)
MAYAR_FORWARD_URL=

# ── Opsional: email (Resend) ───────────────────────────────────────────────

RESEND_API_KEY=
# mis. Talqeeh <halo@talqeeh.id>
EMAIL_FROM=
EMAIL_REPLY_TO=
# Rahasia link berhenti berlangganan email (bawaan: ADMIN_PIN / SUPABASE_SERVICE_ROLE_KEY)
EMAIL_SECRET=
