{
  "version": 2,
  "installCommand": "npm install --registry https://registry.npmjs.org",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": null,
  "functions": {
    "api/ai-partner.js": { "maxDuration": 60 }
  },
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        { "key": "Content-Type", "value": "application/manifest+json" },
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/config",         "destination": "/api/config.js" },
    { "source": "/api/health",         "destination": "/api/health.js" },
    { "source": "/api/admin-auth",     "destination": "/api/admin-auth.js" },
    { "source": "/api/admin-members",  "destination": "/api/admin-members.js" },
    { "source": "/api/send-wa",        "destination": "/api/send-wa.js" },
    { "source": "/(.*)",               "destination": "/index.html" }
  ]
}
